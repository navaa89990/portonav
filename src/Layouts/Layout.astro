---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "NavDev | Portofolio" } = Astro.props;
---

<html lang="id" data-lang="id" class="scroll-smooth bg-[#121214] overflow-x-hidden">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/navdevlogonobck2.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  
  <body id="top" class="bg-[#121214] text-[#e1e1e6] antialiased min-h-screen relative overflow-x-hidden w-full max-w-full">
    
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
      <div class="absolute top-0 left-0 w-150 h-150 bg-sky-500/10 rounded-full blur-[160px]"></div>
      <div class="absolute top-[10vh] right-0 w-150 h-150 bg-blue-600/15 rounded-full blur-[160px]"></div>
    </div>

    <header class="w-full fixed top-0 left-0 bg-[#121214]/40 backdrop-blur-md border-b border-zinc-800/40 z-50">
      <div class="w-full max-w-6xl mx-auto px-4 md:px-12">
        <Navbar />
      </div>
    </header>
    
    <div class="flex flex-col grow pt-20"> {/* Tambahkan padding-top agar konten tidak tertutup fixed navbar */}
      <main class="w-full max-w-6xl mx-auto grow px-4 md:px-12 z-10">
        <slot />
      </main>
      <footer class="w-full max-w-6xl mx-auto px-4 md:px-12 z-10">
        <Footer />
      </footer>
    </div>
    
    <style is:global>
      /* Logic Switcher Bahasa */
      html[data-lang="id"] .lang-en { display: none !important; }
      html[data-lang="en"] .lang-id { display: none !important; }
    </style>

    <script is:inline>
      // Inisialisasi bahasa dari localStorage agar tidak flash saat reload
      const savedLang = localStorage.getItem('navdev-lang') || 'id';
      document.documentElement.setAttribute('data-lang', savedLang);
      
      // Update lang attribute untuk SEO dasar
      document.documentElement.lang = savedLang;
    </script>
  </body>
</html>