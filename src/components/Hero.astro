---
// 1. IMPORT KOMPONEN IMAGE DARI ASTRO (TETAP DIPAKAI UNTUK KOMPRESI)
import { Image } from 'astro:assets';

// 2. IMPORT GAMBAR KAMU SECARA DINAMIS (PASTIKAN NAMA FILE SESUAI)
// Ganti 'avatar-baru.jpg' dengan nama file asli kamu di folder src/assets/
import navdev from '../assets/navdev.jpeg';
---

<section id="hero" class="relative min-h-[80vh] flex flex-col items-center justify-center pt-24 pb-16 w-full z-10">
  {/* Menghapus overflow-hidden di atas agar efek glow dan animasi tidak terpotong */}
  
  <div class="absolute -top-40 -left-40 w-125 h-125 bg-sky-500/10 rounded-full blur-[150px] pointer-events-none z-0 animate-pulse duration-8000"></div>
  
  <div class="absolute bottom-0 right-0 w-150 h-150 bg-blue-600/15 rounded-full blur-[180px] pointer-events-none z-0 animate-pulse duration-5000"></div>
  <div class="w-full max-w-6xl flex flex-col md:flex-row items-center justify-between gap-12 z-10">
    
    <div class="flex-1 space-y-8 text-center md:text-left">
      
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs font-semibold tracking-wide text-zinc-300 backdrop-blur-sm shadow-inner">
        <span class="flex h-2.5 w-2.5 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="lang-id">Tersedia untuk Magang & Proyek</span>
        <span class="lang-en">Available for Internships & Projects</span>
      </div>

      <h1 class="text-6xl md:text-7xl font-black tracking-tight leading-[1.05] text-white">
        <span class="lang-id">Membawa Ide <br />Ke <span class="bg-linear-to-r from-sky-400 via-blue-500 to-indigo-400 bg-clip-text text-transparent drop-shadow-sm transition-all duration-300">Dunia Digital.</span></span>
        <span class="lang-en">Bringing Ideas <br />To <span class="bg-linear-to-r from-sky-400 via-blue-500 to-indigo-400 bg-clip-text text-transparent drop-shadow-sm transition-all duration-300">Digital Life.</span></span>
      </h1>

      <p class="text-lg md:text-xl text-zinc-400 leading-relaxed max-w-xl font-medium">
        <span class="lang-id">Hai, saya <span class="text-white font-bold hover:text-sky-400 transition-colors">NavDev</span>. Siswa PPLG yang fokus menjembatani <span class="text-sky-400 underline decoration-sky-500/30 underline-offset-4">UI/UX Design</span> estetis dengan performa <span class="text-blue-400">Frontend Web</span> yang responsif.</span>
        <span class="lang-en">Hi, I'm <span class="text-white font-bold hover:text-sky-400 transition-colors">NavDev</span>. A software engineering student focused on bridging aesthetic <span class="text-sky-400 underline decoration-sky-500/30 underline-offset-4">UI/UX Design</span> with responsive <span class="text-blue-400">Frontend Web</span> performance.</span>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4 pt-2">
        <a 
          href="#projek" 
          class="group w-full sm:w-auto px-8 py-4 bg-linear-to-r from-sky-500 via-blue-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-zinc-950 font-bold rounded-xl transition-all duration-300 text-center shadow-lg shadow-sky-500/20 active:scale-95 flex items-center justify-center gap-2"
        >
          <span class="lang-id">Lihat Karya Saya</span>
          <span class="lang-en">View My Work</span>
          <span class="group-hover:translate-x-1 transition-transform duration-200">→</span>
        </a>
        <a 
          href="#about" 
          class="w-full sm:w-auto px-8 py-4 bg-zinc-900/60 hover:bg-zinc-800 text-zinc-300 font-semibold rounded-xl transition-all duration-300 text-center border border-zinc-800 backdrop-blur-sm"
        >
          <span class="lang-id">Kenal Lebih Dekat</span>
          <span class="lang-en">Get to Know Me</span>
        </a>
      </div>
    </div>

    <div class="flex-1 w-full max-w-sm md:max-w-md z-10 flex justify-center md:justify-end select-none mt-12 md:mt-0">
      <div class="relative group animate-float">
        
        <div class="absolute -inset-4 bg-linear-to-r from-sky-500 to-blue-600 rounded-4xl opacity-30 blur-2xl group-hover:opacity-50 group-hover:blur-3xl transition-all duration-500 z-0"></div>
        
        <div class="absolute -inset-0.75 bg-linear-to-tr from-sky-400 via-blue-500 to-zinc-800 rounded-4xl shadow-2xl group-hover:scale-[1.01] transition-transform duration-500 z-0"></div>
        
        <div class="relative bg-[#16161a] rounded-[1.9rem] overflow-hidden aspect-4/5 w-70 sm:w-[320px] md:w-90 border border-zinc-900/50 z-10">
          
          <div class="absolute inset-0 bg-linear-to-t from-zinc-950 via-transparent to-transparent opacity-60 z-10"></div>
          
          <Image 
            src={navdev} 
            alt="NavDev Profile" 
            width={400}
            height={500}
            format="webp"
            quality={80}
            class="w-full h-full object-cover object-[center_20%] grayscale-20 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out z-0" 
          />
          
          <div class="absolute bottom-4 left-4 z-20 bg-zinc-900/90 border border-zinc-800 px-3 py-1.5 rounded-xl text-[10px] font-mono text-sky-400 font-bold backdrop-blur-md">
            <span class="lang-id">⚡ Figma ke Kode</span>
            <span class="lang-en">⚡ Figma to Code</span>
          </div>
        </div>
        
        <div class="absolute -top-6 -right-6 bg-zinc-900/80 border border-zinc-800 p-3 rounded-xl backdrop-blur-md hidden lg:block shadow-xl group-hover:translate-y-1 transition-transform duration-300 z-20">
          <span class="text-xs font-bold text-zinc-300 flex items-center gap-1.5">
            💻 <span class="text-emerald-400 lang-id">Siswa PPLG</span>
            <span class="text-emerald-400 lang-en">Software Engineering Student</span>
          </span>
        </div>

      </div>
    </div>

  </div> </section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }
  .animate-float { animation: float 5s ease-in-out infinite; }
</style>