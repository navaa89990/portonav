---
const navLinks = [
  { id: "About", en: "About", href: "#about" },
  { id: "Projects", en: "Projects", href: "#projek" },
  { id: "Process", en: "Process", href: "#process" },
  { id: "Reviews", en: "Reviews", href: "#testimonials" },
  { id: "Contact", en: "Contact", href: "#contact" },
];
---

<div class="h-20 flex items-center justify-between relative">
  <!-- Sisi Kiri: Logo -->
  <a href="#top" class="text-xl md:text-2xl font-bold tracking-tight text-white select-none transition-opacity hover:opacity-90">
    Nav<span class="bg-linear-to-r from-sky-400 to-blue-500 bg-clip-text text-transparent">Dev</span>
  </a>

  <!-- Tengah: Nav List (Desktop Only) -->
  <div class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2">
    {navLinks.map(link => (
      <a href={link.href} class="text-sm font-semibold text-zinc-400 hover:text-white transition-colors duration-300">
        <span class="lang-id">{link.id}</span>
        <span class="lang-en">{link.en}</span>
      </a>
    ))}
  </div>

  <!-- Sisi Kanan: Button & Mobile Toggle -->
  <div class="flex items-center gap-2 md:gap-4">
    <!-- Language Switcher -->
    <button id="lang-switch" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-900/50 border border-zinc-800 text-zinc-400 hover:text-sky-400 transition-all text-[10px] font-bold uppercase tracking-wider">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
      <span class="lang-id">ID</span>
      <span class="lang-en">EN</span>
    </button>

    <a href="#contact" class="hidden md:block px-6 py-2 bg-sky-500 hover:bg-sky-400 text-zinc-950 text-sm font-bold rounded-xl transition-all hover:shadow-xl hover:shadow-sky-500/40 hover:-translate-y-0.5 active:scale-95 shadow-lg shadow-sky-500/20">
      <span class="lang-id">Hire Me</span>
      <span class="lang-en">Hire Me</span>
    </a>

    <button id="menu-toggle" class="md:hidden text-zinc-400 hover:text-white p-2 transition-all active:scale-90 relative w-10 h-10" aria-label="Toggle Menu">
      <svg id="hamburger" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 transition-all duration-300 opacity-0 scale-50 rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<!-- Mobile Menu Dropdown -->
<div id="mobile-menu" class="md:hidden invisible opacity-0 -translate-y-4 pointer-events-none absolute top-19.75 left-0 w-full bg-[#121214] border-b border-zinc-800/50 z-50 shadow-2xl transition-all duration-300 ease-in-out">
  <div class="flex flex-col p-8 space-y-6 transform">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-link text-lg font-semibold text-zinc-400 hover:text-sky-400 transition-all">
        <span class="lang-id">{link.id}</span>
        <span class="lang-en">{link.en}</span>
      </a>
    ))}
    <a href="#contact" class="mobile-link w-full py-4 bg-sky-500 hover:bg-sky-400 text-zinc-950 text-center text-sm font-bold rounded-xl shadow-lg shadow-sky-500/20 transition-all active:scale-[0.98]">
      <span class="lang-id">Hire Me</span>
      <span class="lang-en">Hire Me</span>
    </a>
  </div>
</div>

<script is:inline>
  const btn = document.getElementById('menu-toggle');
  const langBtn = document.getElementById('lang-switch');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger');
  const closeIcon = document.getElementById('close-icon');
  const links = document.querySelectorAll('.mobile-link');

  function toggleMenu() {
    const isOpen = !menu.classList.contains('invisible');
    
    // Menu Dropdown Animation
    menu.classList.toggle('invisible');
    menu.classList.toggle('opacity-0');
    menu.classList.toggle('-translate-y-4');
    menu.classList.toggle('pointer-events-none');
    
    // Icon Animation
    hamburger.classList.toggle('opacity-0');
    hamburger.classList.toggle('rotate-90');
    hamburger.classList.toggle('scale-50');
    
    closeIcon.classList.toggle('opacity-0');
    closeIcon.classList.toggle('rotate-0');
    closeIcon.classList.toggle('scale-100');
  }

  btn.addEventListener('click', toggleMenu);
  
  function updatePlaceholders(lang) {
    document.querySelectorAll('input, textarea').forEach(el => {
      const placeholder = el.getAttribute(`data-${lang}-placeholder`);
      if (placeholder) el.placeholder = placeholder;
    });
  }

  langBtn.addEventListener('click', () => {
    const currentLang = document.documentElement.getAttribute('data-lang');
    const newLang = currentLang === 'id' ? 'en' : 'id';
    document.documentElement.setAttribute('data-lang', newLang);
    document.documentElement.lang = newLang;
    localStorage.setItem('navdev-lang', newLang);
    updatePlaceholders(newLang);
  });

  // Init placeholders on load
  window.addEventListener('DOMContentLoaded', () => {
    const currentLang = document.documentElement.getAttribute('data-lang') || 'id';
    updatePlaceholders(currentLang);
  });

  links.forEach(link => link.addEventListener('click', toggleMenu));
</script>