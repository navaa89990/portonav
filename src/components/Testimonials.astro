---
const testimonials = [
  {
    name: "Muhammad Ropi",
    role: "Front End Developer",
    content_id: "Saya telah meninjau secara langsung proyek web yang dikembangkan oleh NavDev... kualitas UI sangat bersih, modern, dan tertata dengan baik.",
    content_en: "I have personally reviewed the web projects developed by NavDev... the UI quality is very clean, modern, and well-organized.",
    initial: "MR"
  },
  {
    name: "Egi Samsul Mua'rif",
    role_id: "Guru PPLG",
    role_en: "Software Engineering Teacher",
    content_id: "Nava saat ini adalah siswa yang saya lihat cepat belajar dan aktif... Ia mampu mengimplementasikan teknologi modern seperti Astro dengan sangat baik.",
    content_en: "Nava is a student who I see as a fast learner... He is able to implement modern technologies like Astro very well.",
    initial: "ES"
  },
  {
    name: "Siska Olyvia",
    role: "Ui/UX Designer",
    content_id: "Jarang menemukan developer yang punya sense desain kuat sekaligus pemahaman teknis yang mendalam.",
    content_en: "Rare to find a developer with a strong design sense and deep technical understanding.",
    initial: "SO"
  }
];
---

<section id="testimonials" class="py-16 md:py-24 bg-transparent scroll-mt-24">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <div class="inline-block">
        <h2 class="text-blue-500 text-xs md:text-sm tracking-[0.3em] uppercase mb-4 font-bold italic">
          <span class="lang-id">Testimoni</span>
          <span class="lang-en">Testimonials</span>
        </h2>
        <div class="h-1 w-12 bg-blue-500 mx-auto mb-6"></div>
      </div>
      <h3 class="text-4xl md:text-6xl font-bold text-white leading-tight mb-6">
        <span class="lang-id">Apa Kata Mereka Tentang</span>
        <span class="lang-en">What They Say About</span>
        <span class="bg-linear-to-r from-sky-400 via-blue-500 to-indigo-400 bg-clip-text text-transparent"> <span class="lang-id">Kinerja Saya.</span><span class="lang-en">My Performance.</span></span>
      </h3>
      <p class="text-zinc-400 text-base md:text-lg leading-relaxed">
        <span class="lang-id">Kepercayaan adalah prioritas. Berikut adalah feedback dari beberapa mitra yang telah bekerja sama.</span>
        <span class="lang-en">Trust is a priority. Here is feedback from several partners who have collaborated.</span>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map((item) => (
        <div class="group relative p-8 rounded-3xl bg-zinc-900/40 border border-zinc-800/50 backdrop-blur-sm hover:border-blue-500/30 transition-all duration-500 flex flex-col justify-between">
          <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transition-opacity">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="fill-blue-500">
              <path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 7.55228 14.017 7V5C14.017 4.44772 14.4647 4 15.017 4H20.017C21.1216 4 22.017 4.89543 22.017 6V15C22.017 18.3137 19.3307 21 16.017 21H14.017ZM3 21L3 18C3 16.8954 3.89543 16 5 16H8C8.55228 16 9 15.5523 9 15V9C9 8.44772 8.55228 8 8 8H4C3.44772 8 3 7.55228 3 7V5C3 4.44772 3.44772 4 4 4H9C10.1046 4 11 4.89543 11 6V15C11 18.3137 8.31371 21 5 21H3Z" />
            </svg>
          </div>
          
          <div class="relative z-10">
            <p class="text-zinc-300 italic mb-8 leading-relaxed">
              <span class="lang-id">"{item.content_id}"</span>
              <span class="lang-en">"{item.content_en}"</span>
            </p>
          </div>

          <div class="flex items-center gap-4 relative z-10 border-t border-zinc-800 pt-6">
            <div class="w-12 h-12 flex-none rounded-full bg-linear-to-br from-blue-600 to-cyan-500 flex items-center justify-center text-white font-bold text-sm shadow-lg shadow-blue-500/20">
              {item.initial}
            </div>
            <div>
              <h4 class="text-white font-bold text-sm md:text-base leading-none mb-1">{item.name}</h4>
              <p class="text-zinc-500 text-[10px] md:text-xs uppercase tracking-wider">
                <span class="lang-id">{item.role_id || item.role}</span>
                <span class="lang-en">{item.role_en || item.role}</span>
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>