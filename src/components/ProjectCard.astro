---
interface Props {
  title: string;
  desc: string;
  tags: string[];
  link: string;
}

const { title, desc, tags, link } = Astro.props;
---

<div class="bg-[#1e1e22] p-6 rounded-xl border border-zinc-800 hover:border-zinc-700 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
  <div>
    <h3 class="text-xl font-semibold group-hover:text-sky-400 transition-colors">{title}</h3>
    <p class="text-zinc-400 text-sm mt-2 leading-relaxed">{desc}</p>
  </div>
  
  <div class="mt-6">
    <div class="flex flex-wrap gap-1.5 mb-4">
      {tags.map(tag => (
        <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 bg-zinc-800 text-zinc-400 rounded">
          {tag}
        </span>
      ))}
    </div>
    
    <a href={link} target="_blank" class="text-sm font-medium text-sky-400 inline-flex items-center gap-1 hover:underline">
      Lihat Projek <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </div>
</div>