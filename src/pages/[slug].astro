---
import Layout from '../Layouts/Layout.astro';
import { projects } from '../data/project.js';
import { Image } from 'astro:assets';

export const prerender = true;

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | NavDev Project`}>
  <section class="py-12 md:py-20 relative">
    <!-- Back Button -->
    <a href="/#projek" class="inline-flex items-center gap-2 text-zinc-400 hover:text-sky-400 transition-colors mb-12 group">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span class="lang-id text-sm font-bold uppercase tracking-widest">Kembali ke Portofolio</span>
      <span class="lang-en text-sm font-bold uppercase tracking-widest">Back to Portfolio</span>
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Project Info -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-4">
          <h1 class="text-4xl md:text-6xl font-black text-white leading-tight">
            {project.title}
          </h1>
          <div class="flex flex-wrap gap-3">
            {project.tags.map((tag) => (
              <span class="px-3 py-1 rounded-lg bg-zinc-900 border border-zinc-800 text-sky-400 text-[10px] font-bold uppercase tracking-wider">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <div class="space-y-6 text-zinc-400 text-lg leading-relaxed font-medium">
          <p class="lang-id">{project.fullDesc}</p>
          <p class="lang-en">{project.fullDesc_en || project.fullDesc}</p>
        </div>

        <!-- Meta Detail Grid -->
        <div class="grid grid-cols-2 gap-6 p-8 rounded-4xl bg-zinc-900/40 border border-zinc-800/50 backdrop-blur-md">
          <div>
            <h4 class="text-zinc-500 text-[10px] font-bold uppercase tracking-[0.2em] mb-1">
              <span class="lang-id">Kategori</span>
              <span class="lang-en">Category</span>
            </h4>
            <p class="text-white font-bold">
              <span class="lang-id">{project.category_id}</span>
              <span class="lang-en">{project.category_en}</span>
            </p>
          </div>
          <div>
            <h4 class="text-zinc-500 text-[10px] font-bold uppercase tracking-[0.2em] mb-1">
              <span class="lang-id">Tahun</span>
              <span class="lang-en">Year</span>
            </h4>
            <p class="text-white font-bold">{project.year}</p>
          </div>
          <div>
            <h4 class="text-zinc-500 text-[10px] font-bold uppercase tracking-[0.2em] mb-1">
              <span class="lang-id">Peran Saya</span>
              <span class="lang-en">My Role</span>
            </h4>
            <p class="text-white font-bold">
              <span class="lang-id">{project.role_id}</span>
              <span class="lang-en">{project.role_en}</span>
            </p>
          </div>
          <div>
            <h4 class="text-zinc-500 text-[10px] font-bold uppercase tracking-[0.2em] mb-1">Link</h4>
            <a href={project.link} target="_blank" class="text-sky-400 font-bold hover:underline flex items-center gap-1">
              <span class="lang-id">Kunjungi Situs</span>
              <span class="lang-en">Visit Site</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Project Preview Image -->
      <div class="lg:col-span-7">
        <div class="relative group rounded-[2.5rem] overflow-hidden border border-zinc-800 shadow-2xl">
          <div class="absolute inset-0 bg-linear-to-br from-sky-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10"></div>
          <Image 
            src={project.image} 
            alt={project.title} 
            class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700"
          />
        </div>
        
        {project.certificate && (
          <div class="mt-12 space-y-6">
            <h3 class="text-2xl font-bold text-white flex items-center gap-3">
              <span class="w-8 h-px bg-sky-500"></span>
              <span class="lang-id">Sertifikat Proyek</span>
              <span class="lang-en">Project Certificate</span>
            </h3>
            <div class="rounded-4xl overflow-hidden border border-zinc-800">
               <Image src={project.certificate} alt="Certificate" class="w-full h-auto" />
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>